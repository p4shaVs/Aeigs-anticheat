# ---- Database ----
# Dev: SQLite (dosya). Prod: PostgreSQL bağlantı stringi ile değiştirin.
DATABASE_URL="file:./dev.db"

# ---- Auth ----
# Oturum JWT'lerini imzalamak için kullanılan gizli anahtar.
# Prod'da MUTLAKA güçlü, rastgele bir değerle değiştirin: `openssl rand -base64 48`
AUTH_SECRET="degistir-bu-cok-gizli-bir-anahtar-olmali-en-az-32-karakter"

# ---- License / API ----
# FiveM kaynağının (resource) sunucudan API'ye erişirken kullandığı imzalama tuzu.
LICENSE_HMAC_SECRET="degistir-lisans-imzalama-tuzu-uzun-ve-rastgele"

# Uygulama temel URL'i (e-posta / callback / API dokümantasyonu için)
APP_URL="http://localhost:3000"
